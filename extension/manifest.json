{
  "manifest_version": 3,
  "name": "Redact — black out secrets on screen",
  "version": "0.1.0",
  "description": "Blacks out card numbers, live keys, session tokens, IBANs and customer emails on the page you are sharing. One shortcut. Nothing leaves the tab.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redact this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-redaction": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Turn redaction on or off for this page"
    }
  }
}
